<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="\0"
    sling:resourceType="cq/gui/components/authoring/dialog"
    extraClientlibs="[core.wcm.components.title.v2.editor]"
    helpPath="https://www.adobe.com/go/aem_cmp_title_v3"
    trackingFeature="core-components:title:v3">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <card_x0020_details
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Additional Details"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <multi_x0020_level_x0020_1
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                composite="{Boolean}true"
                                                fieldLabel="Details"
                                                name="./multi1">
                                                <field
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/foundation/container"
                                                    name="./fieldProductFoodieSecond">
                                                    <items jcr:primaryType="nt:unstructured">
                                                        <Image
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                            fieldDescription="Leave empty to use the page title."
                                                            fieldLabel="Image"
                                                            name="./foodBlogImage"/>
                                                        <title
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldDescription="Leave empty to use the page title."
                                                            fieldLabel="Title of Product"
                                                            name="./foodBlogTitle"/>
                                                        <date
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/datepicker"
                                                            fieldDescription="Leave empty to use the page title."
                                                            fieldLabel="Date"
                                                            name="./foodBlogDate"
                                                            displayFormat="D MMMM YYYY"
                                                            valueFormat="YYYY-MM-DD"/>
                                                        <description
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                                            fieldDescription="Leave empty to use the page title."
                                                            fieldLabel="Description of Product"
                                                            name="./foodBlogDesc"/>
                                                        <tag
                                                                jcr:primaryType="nt:unstructured"
                                                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                                fieldDescription="Leave empty to use the page title."
                                                                fieldLabel="Explore Category"
                                                                name="./foodExplore">
                                                            <items jcr:primaryType="nt:unstructured">
                                                                <default
                                                                        jcr:primaryType="nt:unstructured"
                                                                        text="Nan"
                                                                        value="Nan"/>
                                                                <option1
                                                                        jcr:primaryType="nt:unstructured"
                                                                        text="Explore"
                                                                        value="Explore"/>
                                                                <option2
                                                                        jcr:primaryType="nt:unstructured"
                                                                        text="Create"
                                                                        value="Create"/>
                                                                <option3
                                                                        jcr:primaryType="nt:unstructured"
                                                                        text="Innovate"
                                                                        value="Innovate"/>
                                                            </items>
                                                        </tag>
                                                    </items>
                                                </field>
                                            </multi_x0020_level_x0020_1>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </card_x0020_details>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
