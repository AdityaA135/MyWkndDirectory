<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="\0"
    sling:resourceType="cq/gui/components/authoring/dialog"
    extraClientlibs="[core.wcm.components.title.v2.editor]"
    helpPath="https://www.adobe.com/go/aem_cmp_title_v3"
    trackingFeature="core-components:title:v3">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <card_x0020_details
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Additional Details"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <multi_x0020_level_x0020_1
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                composite="{Boolean}true"
                                                fieldLabel="Details"
                                                name="./multi1">
                                                <field
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/foundation/container"
                                                    name="./fieldProductFoodie">
                                                    <items jcr:primaryType="nt:unstructured">
                                                        <Image
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                            fieldDescription="Leave empty to use the page title."
                                                            fieldLabel="Image"
                                                            name="./foodImage"/>
                                                        <title
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            fieldDescription="Leave empty to use the page title."
                                                            fieldLabel="Title of Product"
                                                            name="./foodTitle"/>
                                                        <time
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                                            fieldDescription="Leave empty to use the page title."
                                                            fieldLabel="Time"
                                                            name="./foodTime"/>
                                                        <tag
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                            fieldDescription="Leave empty to use the page title."
                                                            fieldLabel="tag of product"
                                                            name="./foodTag">
                                                            <items jcr:primaryType="nt:unstructured">
                                                                <default
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Nan"
                                                                    value="Nan"/>
                                                                <option1
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Veg"
                                                                    value="Veg"/>
                                                                <option2
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Non Veg"
                                                                    value="Non Veg"/>
                                                                <option3
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Vegan"
                                                                    value="Vegan"/>
                                                            </items>
                                                        </tag>
                                                        <level
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                            fieldDescription="Leave empty to use the page title."
                                                            fieldLabel="Level of product"
                                                            name="./foodLevel">
                                                            <items jcr:primaryType="nt:unstructured">
                                                                <default
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Nan"
                                                                    value="Nan"/>
                                                                <option1
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Easy"
                                                                    value="Easy"/>
                                                                <option2
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Intermediate"
                                                                    value="Intermediate"/>
                                                                <option3
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Pro"
                                                                    value="Pro"/>
                                                            </items>
                                                        </level>
                                                        <category
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                            fieldDescription="Leave empty to use the page title."
                                                            fieldLabel="Category"
                                                            name="./category">
                                                            <items jcr:primaryType="nt:unstructured">
                                                                <default
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Nan"
                                                                    value="Nan"/>
                                                                <option1
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Summer"
                                                                    value="Summer"/>
                                                                <option2
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Occasion"
                                                                    value="Occasion"/>
                                                                <option3
                                                                    jcr:primaryType="nt:unstructured"
                                                                    text="Most Loved"
                                                                    value="Most Loved"/>
                                                            </items>
                                                        </category>
                                                    </items>
                                                </field>
                                            </multi_x0020_level_x0020_1>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </card_x0020_details>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
